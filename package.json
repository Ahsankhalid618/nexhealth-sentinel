{
  "name": "nexhealth-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial reliability layer for NexHealth Synchronizer API integrations: verified, deduped webhooks, tracked writes, sync-down alerts and gap recovery.",
  "license": "MIT",
  "author": "Ahsan Khalid",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "sim": "tsx scripts/sim.ts",
    "sandbox:smoke": "tsx scripts/sandbox-smoke.ts",
    "setup:webhooks": "tsx scripts/setup-webhooks.ts",
    "demo:live": "tsx scripts/demo-live.ts",
    "contract:check": "tsx scripts/contract-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
