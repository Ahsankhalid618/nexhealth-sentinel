# Copy to .env.local. Everything is optional in mock mode.

# mock (default): simulated NexHealth, no key needed. live: the real API.
NEXHEALTH_MODE=mock

# Postgres URL (Neon in production). Leave empty to use embedded PGlite in .data/pglite.
DATABASE_URL=

# ---- live mode ----
NEXHEALTH_API_KEY=
# Defaults to https://nexhealth.info
NEXHEALTH_BASE_URL=
# Written by `pnpm setup:webhooks` (the endpoint's secret_key).
NEXHEALTH_WEBHOOK_SECRET=
# Public HTTPS URL of /api/webhooks/nexhealth. Used by setup:webhooks and the endpoint watchdog.
WEBHOOK_TARGET_URL=
# Used by the scripts.
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_LOCATION_ID=

# Bearer secret for /api/cron/tick and the write endpoints. Required in live mode.
CRON_SECRET=

# ---- tuning ----
# Reject webhooks whose timestamp header is older than this many seconds. 0 disables the check.
WEBHOOK_TOLERANCE_SEC=300
# Page when writes are blocked for this many minutes inside office hours.
SYNC_ALERT_AFTER_MIN=30
# Read back a pending write after this many minutes.
STUCK_WRITE_AFTER_MIN=30
# will_wait: book anyway and say it will wait. refuse: don't send when the sync can't take writes.
PREFLIGHT_MODE=will_wait
# Per-location office hours; keys are "default" or "<subdomain>:<location_id>". Days: 0=Sunday.
# OFFICE_HOURS_JSON={"default":{"days":[1,2,3,4,5],"open":"08:00","close":"18:00"},"my-practice:101":{"days":[1,2,3,4,5,6],"open":"07:00","close":"16:00"}}
OFFICE_HOURS_JSON=

# Slack or Discord incoming webhook for critical and warning alerts. No patient data is sent.
ALERT_WEBHOOK_URL=

# Save each incoming delivery (patient fields redacted, secret never written) for checking against the docs.
# CAPTURE_WEBHOOKS_DIR=fixtures/sandbox/captures
CAPTURE_WEBHOOKS_DIR=

# Where scripts reach the app.
APP_URL=http://localhost:3000
